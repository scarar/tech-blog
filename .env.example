# Database Connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=blog_db

# Authentication
JWT_SECRET=your_jwt_secret_key

# Server Configuration
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-github-username.github.io/blog

# Set to true to enable database debug logging
DEBUG_DB=false

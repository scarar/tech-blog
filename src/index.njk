---
layout: base.njk
title: Home
---

<div class="home-page">
  <section class="hero">
    <div class="hero-content">
      <h1>Timothy Monnig</h1>
      <p class="hero-subtitle">Software Engineer | Tech Innovator | AI Enthusiast</p>
      <div class="hero-cta">
        <a href="/about" class="btn btn-primary">About Me</a>
        <a href="/posts" class="btn btn-secondary">View Blog</a>
      </div>
    </div>
  </section>

  <section class="featured-posts">
    <h2>Latest Insights</h2>
    <div id="featured-posts" class="posts-grid">
      <!-- Posts will be loaded dynamically -->
      <div class="loading-indicator">Loading posts...</div>
    </div>
    <div class="view-all-container">
      <a href="/posts" class="btn btn-view-all">Explore All Posts</a>
    </div>
  </section>

  <section class="blog-tags">
    <h2>Explore by Topics</h2>
    <div class="tags-container" id="tags-container">
      <!-- Tags will be loaded dynamically -->
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const postsContainer = document.getElementById('featured-posts');
    const tagsContainer = document.getElementById('tags-container');
    
    // Check if there's a tag filter in the URL
    const urlParams = new URLSearchParams(window.location.search);
    const tagFilter = urlParams.get('tag');
    
    // Fetch posts from the API
    fetch('http://localhost:3000/public-posts')
      .then(response => {
        if (!response.ok) {
          throw new Error('Failed to fetch posts');
        }
        return response.json();
      })
      .then(posts => {
        console.log('Fetched posts:', posts); // Debug: log the posts
        
        if (posts.length === 0) {
          postsContainer.innerHTML = '<div class="no-posts">No posts available yet. Check back soon!</div>';
          return;
        }
        
        // Filter posts by tag if tag parameter is present
        let filteredPosts = posts;
        if (tagFilter) {
          console.log(`Filtering posts by tag: '${tagFilter}'`);
          
          // This approach logs each step for debugging
          filteredPosts = posts.filter(post => {
            if (!post.tags) {
              console.log(`Post ${post.id} has no tags`);
              return false;
            }
            
            // Split and normalize tags
            const postTags = post.tags.split(',')
              .map(t => t.trim().toLowerCase());
            
            console.log(`Post ${post.id} has tags:`, postTags);
            
            // Check if the tag is included - handle exact match case-insensitive
            return postTags.some(tag => tag.toLowerCase() === tagFilter.toLowerCase());
          });
          
          console.log('Filtered posts:', filteredPosts);
          
          // Add a heading to show which tag is being filtered - directly to the postsContainer
          if (postsContainer) {
            const filterInfo = document.createElement('div');
            filterInfo.className = 'filter-info';
            filterInfo.innerHTML = `<h3 class="filter-heading">Posts tagged with "<span class="highlight">${tagFilter}</span>" <a href="/" class="clear-filter">(Clear filter)</a></h3>`;
            postsContainer.parentNode.insertBefore(filterInfo, postsContainer);
          }
          
          // If no posts match the tag
          if (filteredPosts.length === 0) {
            postsContainer.innerHTML = `<div class="no-posts">No posts found with the tag "${tagFilter}". <a href="/">View all posts</a></div>`;
            return;
          }
        }
        
        // Display posts (all or filtered)
        const postsToShow = tagFilter ? filteredPosts : filteredPosts.slice(0, 3);
        postsContainer.innerHTML = postsToShow.map(post => `
          <div class="card post-card">
            <h3 class="post-title">${post.title}</h3>
            <p class="post-excerpt">${post.excerpt || 'No excerpt available'}</p>
            <div class="post-meta">
              <span class="post-date">${new Date(post.created_at).toLocaleDateString()}</span>
              <span class="post-author">By ${post.author || 'Admin'}</span>
            </div>
            <a href="/post/${post.id}/" class="read-more">Read More</a>
          </div>
        `).join('');
        
        // Extract and display unique tags
        const allTags = [];
        posts.forEach(post => {
          if (post.tags) {
            const postTags = post.tags.split(',');
            postTags.forEach(tag => {
              tag = tag.trim();
              if (tag && !allTags.includes(tag)) {
                allTags.push(tag);
              }
            });
          }
        });
        
        if (allTags.length > 0) {
          tagsContainer.innerHTML = allTags.map(tag => 
            `<a href="/?tag=${encodeURIComponent(tag)}" class="tag ${tagFilter && tagFilter.toLowerCase() === tag.toLowerCase() ? 'active' : ''}">${tag}</a>`
          ).join('');
        } else {
          tagsContainer.innerHTML = '<p>No tags available yet.</p>';
        }
      })
      .catch(error => {
        console.error('Error fetching posts:', error);
        postsContainer.innerHTML = '<div class="error">Failed to load posts. Please try again later.</div>';
      });
  });
</script>

<style>

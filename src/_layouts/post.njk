---
layout: base.njk
---

<article class="blog-post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time datetime="{{ page.date | date('YYYY-MM-DD') }}">
      {{ page.date | formatDate }}
    </time>
    
    {% if tags %}
    <div class="post-tags">
      {% for tag in tags %}
        {% if tag != "posts" %}
          <span class="tag">{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>
</article>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or metadata.title }} | My Tech Blog</title>
    <meta name="description" content="{{ description or metadata.description }}">
    <style>
        :root {
            --background-color: #16213e;
            --dark-background: #16213e;
            --accent-color: #8e65f0;
            --text-color: #e6e6e6;
            --secondary-text: #a0a0a0;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        body {
            background-color: var(--background-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        .blog-post-preview {
            background-color: var(--dark-background);
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            padding: 20px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .blog-post-preview:hover {
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
            transform: translateY(-5px);
        }

        .post-preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 10px;
        }

        .post-preview-title a {
            color: var(--accent-color);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .post-preview-title a:hover {
            color: var(--accent-color);
        }

        .post-preview-date {
            color: var(--secondary-text);
            font-size: 0.9em;
        }

        .post-preview-content {
            margin-bottom: 15px;
            color: var(--text-color);
        }

        .post-preview-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 10px;
        }

        .post-preview-tags .tag {
            background-color: rgba(142, 101, 240, 0.15);
            color: var(--accent-color);
            padding: 3px 8px;
            border-radius: 4px;
            margin-right: 5px;
            font-size: 0.8em;
            transition: all 0.3s ease;
        }

        .post-preview-tags .tag:hover {
            background-color: var(--accent-color);
            color: white;
        }

        .read-more {
            color: var(--accent-color);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .read-more:hover {
            opacity: 0.8;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        nav {
            background-color: var(--dark-background);
            color: var(--text-color);
            padding: 15px 0;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        nav .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav a {
            color: var(--text-color);
            text-decoration: none;
            margin-left: 15px;
            transition: all 0.3s ease;
        }

        nav a:hover {
            color: var(--accent-color);
        }

        footer {
            background-color: var(--dark-background);
            color: var(--secondary-text);
            text-align: center;
            padding: 20px 0;
            margin-top: 30px;
        }

        /* Responsive Adjustments */
        @media (max-width: 768px) {
            .post-preview-header {
                flex-direction: column;
                align-items: flex-start;
            }

            nav .container {
                flex-direction: column;
                text-align: center;
            }

            nav a {
                margin: 10px 0;
            }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <nav>
        <div class="container">
            <div class="logo">My Tech Blog</div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/posts">Blog</a>
                <a href="/about">About</a>
                <a href="/admin">Admin</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <main>
            {% block content %}
            {{ content | safe }}
            {% endblock %}
        </main>
    </div>

    <footer>
        <p>© {{ currentYear }} My Tech Blog. All rights reserved.</p>
    </footer>

    <script>
        // Global JavaScript can go here
        document.addEventListener('DOMContentLoaded', () => {
            const currentYear = new Date().getFullYear();
            document.querySelector('footer p').innerHTML = `© ${currentYear} My Tech Blog. All rights reserved.`;
        });
    </script>
</body>
</html>
